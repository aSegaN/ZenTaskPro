# ============================================
# Backend ZenTask Pro — variables d'environnement
# ============================================

# Base de données
# Dev (SQLite) :
# DATABASE_URL="file:./prisma/dev.db"
# Prod (PostgreSQL — Neon/Supabase/…):
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/zentask?schema=public&sslmode=require"

# Serveur
PORT=4000
NODE_ENV=production

# Auth
JWT_SECRET="REMPLACER_PAR_UNE_CHAINE_LONGUE_ALEATOIRE"
JWT_EXPIRES_IN=7200
# Fenêtre (s) pendant laquelle un jeton expiré peut encore être rafraîchi (défaut 7 jours)
REFRESH_GRACE_SECONDS=604800

# CORS (origines autorisées, séparées par des virgules)
CORS_ORIGINS="https://ton-front.example"

# IA (Gemini) — utilisé côté serveur uniquement
GEMINI_API_KEY=""

# Observabilité
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE=0.1
LOG_LEVEL=info

# Divers
DISABLE_RATE_LIMIT=false
