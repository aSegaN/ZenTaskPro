# ============================================
# ZENTASK PRO - CONFIGURATION SERVEUR
# ============================================
# Copiez ce fichier vers .env et modifiez les valeurs

# --------------------------------------------
# BASE DE DONNÉES
# --------------------------------------------
DATABASE_URL="file:./dev.db"

# --------------------------------------------
# SERVEUR
# --------------------------------------------
PORT=4000
NODE_ENV=development
# NODE_ENV=production

# --------------------------------------------
# AUTHENTIFICATION JWT
# --------------------------------------------
# ⚠️ IMPORTANT: Changez cette clé en production!
# Générez une clé sécurisée: openssl rand -base64 64
JWT_SECRET=votre-super-secret-jwt-a-changer-en-production-minimum-32-caracteres
JWT_EXPIRES_IN=7200

# --------------------------------------------
# CORS - Origines autorisées
# --------------------------------------------
# En développement, laissez vide pour autoriser localhost
# En production, listez les domaines séparés par des virgules
# CORS_ORIGINS=https://zentask.example.com,https://app.zentask.com
CORS_ORIGINS=

# --------------------------------------------
# RATE LIMITING
# --------------------------------------------
# Mettre à "true" pour désactiver en développement
DISABLE_RATE_LIMIT=false

# --------------------------------------------
# LOGGING
# --------------------------------------------
LOG_LEVEL=info
# LOG_LEVEL=debug
# LOG_LEVEL=warn
# LOG_LEVEL=error

# ============================================
# EXEMPLE DE CONFIGURATION PRODUCTION
# ============================================
# NODE_ENV=production
# JWT_SECRET=une-vraie-cle-secrete-generee-avec-openssl
# CORS_ORIGINS=https://zentask.votre-domaine.com
# DISABLE_RATE_LIMIT=false
# LOG_LEVEL=warn
