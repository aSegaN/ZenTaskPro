datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// Modèles basés sur vos interfaces Frontend

model User {
  id         String    @id @default(uuid())
  firstName  String
  lastName   String
  username   String    @unique
  email      String    @unique
  password   String    // Sera haché
  phone      String?
  avatar     String?
  role       String    @default("CONTRIBUTOR") // ADMIN, MANAGER, CONTRIBUTOR
  department String?
  
  tasks      Task[]    @relation("TaskAssignee")
  assignedSubtasks SubTask[]
  
  projects   Project[] // Projets dont il est owner
  comments   Comment[]
  
  createdAt  DateTime  @default(now())
}

model Project {
  id        String   @id @default(uuid())
  name      String
  color     String
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  tasks     Task[]
  createdAt DateTime @default(now())
}

model Task {
  id          String   @id @default(uuid())
  title       String
  description String?
  status      String   @default("TODO")
  priority    String   @default("MEDIUM")
  dueDate     String   // Stocké en string YYYY-MM-DD pour simplicité frontend
  
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  assigneeId  String
  assignee    User     @relation("TaskAssignee", fields: [assigneeId], references: [id])
  
  subtasks    SubTask[]
  comments    Comment[]
  attachments Attachment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SubTask {
  id         String  @id @default(uuid())
  title      String
  completed  Boolean @default(false)
  dueDate    String?
  
  taskId     String
  task       Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  assigneeId String?
  assignee   User?   @relation(fields: [assigneeId], references: [id])
}

model Comment {
  id        String   @id @default(uuid())
  text      String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Attachment {
  id        String   @id @default(uuid())
  name      String
  url       String
  type      String
  size      String
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}