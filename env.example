# ============================================
# ZenTask Pro - Variables d'Environnement
# ============================================
# Copier ce fichier en .env et adapter les valeurs

# --- Base de données ---
DATABASE_URL="file:./dev.db"

# --- Serveur ---
PORT=4000
NODE_ENV=development

# --- Authentification JWT ---
# ⚠️ IMPORTANT: Changer cette clé en production!
# Générer une clé sécurisée: openssl rand -base64 64
JWT_SECRET="CHANGE_ME_IN_PRODUCTION_use_a_long_random_string_at_least_32_chars"
JWT_EXPIRES_IN="2h"

# --- CORS (optionnel) ---
# CORS_ORIGIN="http://localhost:5173"

# --- Logs (optionnel) ---
# LOG_LEVEL="debug"
